# Copy to .env.local (or set in Vercel → Settings → Environment Variables).
# Never commit real values. Everything is optional: the site works without them.

# --- Public (safe to expose) -------------------------------------------------
# The final, confirmed address of the site. Until it is set, canonical URLs are
# omitted and search engines are asked not to index (robots: noindex).
NEXT_PUBLIC_SITE_URL=
# Set to "false" to keep a confirmed domain out of search engines anyway (e.g. staging).
NEXT_PUBLIC_ALLOW_INDEXING=

# --- Server only (secret — no NEXT_PUBLIC_ prefix) ---------------------------
# Contact form by email via Resend (https://resend.com). Both needed.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# A sender on a domain verified in Resend, e.g. "TechMood <hello@yourdomain>".
CONTACT_FROM_EMAIL=

# Contact form to Telegram (create a bot with @BotFather; the chat id of the
# private chat or group that should receive requests). Both needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
