# ---------------------------------------------------------------
# Halaqati — environment variables (copy to .env.local)
# Never commit real values.
# ---------------------------------------------------------------

# Public site URL, used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API). These two are public by design;
# data is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# SERVER ONLY. Used exclusively for login/registration rate limiting.
# Never prefix with NEXT_PUBLIC_. Optional: without it an in-memory
# limiter is used (per server instance).
SUPABASE_SERVICE_ROLE_KEY=

# Local database tests (plain PostgreSQL 15+, no Docker needed).
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
