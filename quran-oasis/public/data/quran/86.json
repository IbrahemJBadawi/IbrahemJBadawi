{"n":86,"ayahs":[{"a":1,"t":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","p":591,"j":30},{"a":2,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ","p":591,"j":30},{"a":3,"t":"ٱلنَّجۡمُ ٱلثَّاقِبُ","p":591,"j":30},{"a":4,"t":"إِن كُلُّ نَفۡسࣲ لَّمَّا عَلَيۡهَا حَافِظࣱ‏","p":591,"j":30},{"a":5,"t":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ","p":591,"j":30},{"a":6,"t":"خُلِقَ مِن مَّآءࣲ دَافِقࣲ‏","p":591,"j":30},{"a":7,"t":"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ","p":591,"j":30},{"a":8,"t":"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرࣱ‏","p":591,"j":30},{"a":9,"t":"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ","p":591,"j":30},{"a":10,"t":"فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا نَاصِرࣲ‏","p":591,"j":30},{"a":11,"t":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ","p":591,"j":30},{"a":12,"t":"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ","p":591,"j":30},{"a":13,"t":"إِنَّهُۥ لَقَوۡلࣱ فَصۡلࣱ‏","p":591,"j":30},{"a":14,"t":"وَمَا هُوَ بِٱلۡهَزۡلِ","p":591,"j":30},{"a":15,"t":"إِنَّهُمۡ يَكِيدُونَ كَيۡدࣰ ا","p":591,"j":30},{"a":16,"t":"وَأَكِيدُ كَيۡدࣰ ا","p":591,"j":30},{"a":17,"t":"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا","p":591,"j":30}]}