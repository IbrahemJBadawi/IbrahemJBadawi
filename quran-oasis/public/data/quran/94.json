{"n":94,"ayahs":[{"a":1,"t":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","p":596,"j":30},{"a":2,"t":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","p":596,"j":30},{"a":3,"t":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ","p":596,"j":30},{"a":4,"t":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","p":596,"j":30},{"a":5,"t":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","p":596,"j":30},{"a":6,"t":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرࣰ ا","p":596,"j":30},{"a":7,"t":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","p":596,"j":30},{"a":8,"t":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب","p":596,"j":30}]}