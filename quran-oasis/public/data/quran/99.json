{"n":99,"ayahs":[{"a":1,"t":"إِذَا زُلۡزِلَتِ ٱلۡأَرۡضُ زِلۡزَالَهَا","p":599,"j":30},{"a":2,"t":"وَأَخۡرَجَتِ ٱلۡأَرۡضُ أَثۡقَالَهَا","p":599,"j":30},{"a":3,"t":"وَقَالَ ٱلۡإِنسَٰنُ مَا لَهَا","p":599,"j":30},{"a":4,"t":"يَوۡمَئِذࣲ تُحَدِّثُ أَخۡبَارَهَا","p":599,"j":30},{"a":5,"t":"بِأَنَّ رَبَّكَ أَوۡحَىٰ لَهَا","p":599,"j":30},{"a":6,"t":"يَوۡمَئِذࣲ يَصۡدُرُ ٱلنَّاسُ أَشۡتَاتࣰ ا لِّيُرَوۡاْ أَعۡمَٰلَهُمۡ","p":599,"j":30},{"a":7,"t":"فَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٍ خَيۡرࣰ ا يَرَهُۥ","p":599,"j":30},{"a":8,"t":"وَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةࣲ شَرࣰّ ا يَرَهُۥ","p":599,"j":30}]}