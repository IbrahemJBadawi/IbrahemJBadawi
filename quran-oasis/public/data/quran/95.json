{"n":95,"ayahs":[{"a":1,"t":"وَٱلتِّينِ وَٱلزَّيۡتُونِ","p":597,"j":30},{"a":2,"t":"وَطُورِ سِينِينَ","p":597,"j":30},{"a":3,"t":"وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ","p":597,"j":30},{"a":4,"t":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمࣲ‏","p":597,"j":30},{"a":5,"t":"ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ","p":597,"j":30},{"a":6,"t":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونࣲ‏","p":597,"j":30},{"a":7,"t":"فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ","p":597,"j":30},{"a":8,"t":"أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ","p":597,"j":30}]}