{"n":91,"ayahs":[{"a":1,"t":"وَٱلشَّمۡسِ وَضُحَىٰهَا","p":595,"j":30},{"a":2,"t":"وَٱلۡقَمَرِ إِذَا تَلَىٰهَا","p":595,"j":30},{"a":3,"t":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","p":595,"j":30},{"a":4,"t":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا","p":595,"j":30},{"a":5,"t":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","p":595,"j":30},{"a":6,"t":"وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا","p":595,"j":30},{"a":7,"t":"وَنَفۡسࣲ وَمَا سَوَّىٰهَا","p":595,"j":30},{"a":8,"t":"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا","p":595,"j":30},{"a":9,"t":"قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا","p":595,"j":30},{"a":10,"t":"وَقَدۡ خَابَ مَن دَسَّىٰهَا","p":595,"j":30},{"a":11,"t":"كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ","p":595,"j":30},{"a":12,"t":"إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا","p":595,"j":30},{"a":13,"t":"فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا","p":595,"j":30},{"a":14,"t":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا","p":595,"j":30},{"a":15,"t":"وَلَا يَخَافُ عُقۡبَٰهَا","p":595,"j":30}]}