{"n":87,"ayahs":[{"a":1,"t":"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى","p":591,"j":30},{"a":2,"t":"ٱلَّذِي خَلَقَ فَسَوَّىٰ","p":591,"j":30},{"a":3,"t":"وَٱلَّذِي قَدَّرَ فَهَدَىٰ","p":591,"j":30},{"a":4,"t":"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ","p":591,"j":30},{"a":5,"t":"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ","p":591,"j":30},{"a":6,"t":"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ","p":591,"j":30},{"a":7,"t":"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ","p":591,"j":30},{"a":8,"t":"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ","p":591,"j":30},{"a":9,"t":"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ","p":591,"j":30},{"a":10,"t":"سَيَذَّكَّرُ مَن يَخۡشَىٰ","p":591,"j":30},{"a":11,"t":"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى","p":591,"j":30},{"a":12,"t":"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ","p":591,"j":30},{"a":13,"t":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ","p":591,"j":30},{"a":14,"t":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ","p":591,"j":30},{"a":15,"t":"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ","p":591,"j":30},{"a":16,"t":"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","p":592,"j":30},{"a":17,"t":"وَٱلۡأٓخِرَةُ خَيۡرࣱ وَأَبۡقَىٰٓ","p":592,"j":30},{"a":18,"t":"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ","p":592,"j":30},{"a":19,"t":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ","p":592,"j":30}]}