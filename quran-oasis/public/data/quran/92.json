{"n":92,"ayahs":[{"a":1,"t":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰ","p":595,"j":30},{"a":2,"t":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","p":595,"j":30},{"a":3,"t":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ","p":595,"j":30},{"a":4,"t":"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ","p":595,"j":30},{"a":5,"t":"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ","p":595,"j":30},{"a":6,"t":"وَصَدَّقَ بِٱلۡحُسۡنَىٰ","p":595,"j":30},{"a":7,"t":"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ","p":595,"j":30},{"a":8,"t":"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ","p":595,"j":30},{"a":9,"t":"وَكَذَّبَ بِٱلۡحُسۡنَىٰ","p":595,"j":30},{"a":10,"t":"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ","p":595,"j":30},{"a":11,"t":"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","p":595,"j":30},{"a":12,"t":"إِنَّ عَلَيۡنَا لَلۡهُدَىٰ","p":595,"j":30},{"a":13,"t":"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ","p":595,"j":30},{"a":14,"t":"فَأَنذَرۡتُكُمۡ نَارࣰ ا تَلَظَّىٰ","p":595,"j":30},{"a":15,"t":"لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى","p":596,"j":30},{"a":16,"t":"ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ","p":596,"j":30},{"a":17,"t":"وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى","p":596,"j":30},{"a":18,"t":"ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ","p":596,"j":30},{"a":19,"t":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةࣲ تُجۡزَىٰٓ","p":596,"j":30},{"a":20,"t":"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ","p":596,"j":30},{"a":21,"t":"وَلَسَوۡفَ يَرۡضَىٰ","p":596,"j":30}]}