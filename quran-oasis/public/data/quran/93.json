{"n":93,"ayahs":[{"a":1,"t":"وَٱلضُّحَىٰ","p":596,"j":30},{"a":2,"t":"وَٱلَّيۡلِ إِذَا سَجَىٰ","p":596,"j":30},{"a":3,"t":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","p":596,"j":30},{"a":4,"t":"وَلَلۡأٓخِرَةُ خَيۡرࣱ لَّكَ مِنَ ٱلۡأُولَىٰ","p":596,"j":30},{"a":5,"t":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ","p":596,"j":30},{"a":6,"t":"أَلَمۡ يَجِدۡكَ يَتِيمࣰ ا فَـَٔاوَىٰ","p":596,"j":30},{"a":7,"t":"وَوَجَدَكَ ضَآلࣰّ ا فَهَدَىٰ","p":596,"j":30},{"a":8,"t":"وَوَجَدَكَ عَآئِلࣰ ا فَأَغۡنَىٰ","p":596,"j":30},{"a":9,"t":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ","p":596,"j":30},{"a":10,"t":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ","p":596,"j":30},{"a":11,"t":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ","p":596,"j":30}]}