{"n":70,"ayahs":[{"a":1,"t":"سَأَلَ سَآئِلُۢ بِعَذَابࣲ وَاقِعࣲ‏","p":568,"j":29},{"a":2,"t":"لِّلۡكَٰفِرِينَ لَيۡسَ لَهُۥ دَافِعࣱ‏","p":568,"j":29},{"a":3,"t":"مِّنَ ٱللَّهِ ذِي ٱلۡمَعَارِجِ","p":568,"j":29},{"a":4,"t":"تَعۡرُجُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيۡهِ فِي يَوۡمࣲ كَانَ مِقۡدَارُهُۥ خَمۡسِينَ أَلۡفَ سَنَةࣲ‏","p":568,"j":29},{"a":5,"t":"فَٱصۡبِرۡ صَبۡرࣰ ا جَمِيلًا","p":568,"j":29},{"a":6,"t":"إِنَّهُمۡ يَرَوۡنَهُۥ بَعِيدࣰ ا","p":568,"j":29},{"a":7,"t":"وَنَرَىٰهُ قَرِيبࣰ ا","p":568,"j":29},{"a":8,"t":"يَوۡمَ تَكُونُ ٱلسَّمَآءُ كَٱلۡمُهۡلِ","p":568,"j":29},{"a":9,"t":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ","p":568,"j":29},{"a":10,"t":"وَلَا يَسۡـَٔلُ حَمِيمٌ حَمِيمࣰ ا","p":568,"j":29},{"a":11,"t":"يُبَصَّرُونَهُمۡۚ يَوَدُّ ٱلۡمُجۡرِمُ لَوۡ يَفۡتَدِي مِنۡ عَذَابِ يَوۡمِئِذِۭ بِبَنِيهِ","p":569,"j":29},{"a":12,"t":"وَصَٰحِبَتِهِۦ وَأَخِيهِ","p":569,"j":29},{"a":13,"t":"وَفَصِيلَتِهِ ٱلَّتِي تُـٔۡوِيهِ","p":569,"j":29},{"a":14,"t":"وَمَن فِي ٱلۡأَرۡضِ جَمِيعࣰ ا ثُمَّ يُنجِيهِ","p":569,"j":29},{"a":15,"t":"كَلَّآۖ إِنَّهَا لَظَىٰ","p":569,"j":29},{"a":16,"t":"نَزَّاعَةࣰ لِّلشَّوَىٰ","p":569,"j":29},{"a":17,"t":"تَدۡعُواْ مَنۡ أَدۡبَرَ وَتَوَلَّىٰ","p":569,"j":29},{"a":18,"t":"وَجَمَعَ فَأَوۡعَىٰٓ","p":569,"j":29},{"a":19,"t":"۞إِنَّ ٱلۡإِنسَٰنَ خُلِقَ هَلُوعًا","p":569,"j":29},{"a":20,"t":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعࣰ ا","p":569,"j":29},{"a":21,"t":"وَإِذَا مَسَّهُ ٱلۡخَيۡرُ مَنُوعًا","p":569,"j":29},{"a":22,"t":"إِلَّا ٱلۡمُصَلِّينَ","p":569,"j":29},{"a":23,"t":"ٱلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ دَآئِمُونَ","p":569,"j":29},{"a":24,"t":"وَٱلَّذِينَ فِيٓ أَمۡوَٰلِهِمۡ حَقࣱّ مَّعۡلُومࣱ‏","p":569,"j":29},{"a":25,"t":"لِّلسَّآئِلِ وَٱلۡمَحۡرُومِ","p":569,"j":29},{"a":26,"t":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوۡمِ ٱلدِّينِ","p":569,"j":29},{"a":27,"t":"وَٱلَّذِينَ هُم مِّنۡ عَذَابِ رَبِّهِم مُّشۡفِقُونَ","p":569,"j":29},{"a":28,"t":"إِنَّ عَذَابَ رَبِّهِمۡ غَيۡرُ مَأۡمُونࣲ‏","p":569,"j":29},{"a":29,"t":"وَٱلَّذِينَ هُمۡ لِفُرُوجِهِمۡ حَٰفِظُونَ","p":569,"j":29},{"a":30,"t":"إِلَّا عَلَىٰٓ أَزۡوَٰجِهِمۡ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ فَإِنَّهُمۡ غَيۡرُ مَلُومِينَ","p":569,"j":29},{"a":31,"t":"فَمَنِ ٱبۡتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ ٱلۡعَادُونَ","p":569,"j":29},{"a":32,"t":"وَٱلَّذِينَ هُمۡ لِأَمَٰنَٰتِهِمۡ وَعَهۡدِهِمۡ رَٰعُونَ","p":569,"j":29},{"a":33,"t":"وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمۡ قَآئِمُونَ","p":569,"j":29},{"a":34,"t":"وَٱلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ يُحَافِظُونَ","p":569,"j":29},{"a":35,"t":"أُوْلَٰٓئِكَ فِي جَنَّٰتࣲ مُّكۡرَمُونَ","p":569,"j":29},{"a":36,"t":"فَمَالِ ٱلَّذِينَ كَفَرُواْ قِبَلَكَ مُهۡطِعِينَ","p":569,"j":29},{"a":37,"t":"عَنِ ٱلۡيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ","p":569,"j":29},{"a":38,"t":"أَيَطۡمَعُ كُلُّ ٱمۡرِيࣲٕ مِّنۡهُمۡ أَن يُدۡخَلَ جَنَّةَ نَعِيمࣲ‏","p":569,"j":29},{"a":39,"t":"كَلَّآۖ إِنَّا خَلَقۡنَٰهُم مِّمَّا يَعۡلَمُونَ","p":569,"j":29},{"a":40,"t":"فَلَآ أُقۡسِمُ بِرَبِّ ٱلۡمَشَٰرِقِ وَٱلۡمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ","p":570,"j":29},{"a":41,"t":"عَلَىٰٓ أَن نُّبَدِّلَ خَيۡرࣰ ا مِّنۡهُمۡ وَمَا نَحۡنُ بِمَسۡبُوقِينَ","p":570,"j":29},{"a":42,"t":"فَذَرۡهُمۡ يَخُوضُواْ وَيَلۡعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوۡمَهُمُ ٱلَّذِي يُوعَدُونَ","p":570,"j":29},{"a":43,"t":"يَوۡمَ يَخۡرُجُونَ مِنَ ٱلۡأَجۡدَاثِ سِرَاعࣰ ا كَأَنَّهُمۡ إِلَىٰ نُصُبࣲ يُوفِضُونَ","p":570,"j":29},{"a":44,"t":"خَٰشِعَةً أَبۡصَٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةࣱۚ ذَٰلِكَ ٱلۡيَوۡمُ ٱلَّذِي كَانُواْ يُوعَدُونَ","p":570,"j":29}]}