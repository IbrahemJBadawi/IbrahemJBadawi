{"n":106,"ayahs":[{"a":1,"t":"لِإِيلَٰفِ قُرَيۡشٍ","p":602,"j":30},{"a":2,"t":"إِۦلَٰفِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ","p":602,"j":30},{"a":3,"t":"فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ","p":602,"j":30},{"a":4,"t":"ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعࣲ وَءَامَنَهُم مِّنۡ خَوۡفِۭ","p":602,"j":30}]}