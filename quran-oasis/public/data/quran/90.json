{"n":90,"ayahs":[{"a":1,"t":"لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ","p":594,"j":30},{"a":2,"t":"وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ","p":594,"j":30},{"a":3,"t":"وَوَالِدࣲ وَمَا وَلَدَ","p":594,"j":30},{"a":4,"t":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ","p":594,"j":30},{"a":5,"t":"أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدࣱ‏","p":594,"j":30},{"a":6,"t":"يَقُولُ أَهۡلَكۡتُ مَالࣰ ا لُّبَدًا","p":594,"j":30},{"a":7,"t":"أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ","p":594,"j":30},{"a":8,"t":"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ","p":594,"j":30},{"a":9,"t":"وَلِسَانࣰ ا وَشَفَتَيۡنِ","p":594,"j":30},{"a":10,"t":"وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ","p":594,"j":30},{"a":11,"t":"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ","p":594,"j":30},{"a":12,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ","p":594,"j":30},{"a":13,"t":"فَكُّ رَقَبَةٍ","p":594,"j":30},{"a":14,"t":"أَوۡ إِطۡعَٰمࣱ فِي يَوۡمࣲ ذِي مَسۡغَبَةࣲ‏","p":594,"j":30},{"a":15,"t":"يَتِيمࣰ ا ذَا مَقۡرَبَةٍ","p":594,"j":30},{"a":16,"t":"أَوۡ مِسۡكِينࣰ ا ذَا مَتۡرَبَةࣲ‏","p":594,"j":30},{"a":17,"t":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ","p":594,"j":30},{"a":18,"t":"أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ","p":594,"j":30},{"a":19,"t":"وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ","p":594,"j":30},{"a":20,"t":"عَلَيۡهِمۡ نَارࣱ مُّؤۡصَدَةُۢ","p":594,"j":30}]}