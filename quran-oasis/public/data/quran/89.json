{"n":89,"ayahs":[{"a":1,"t":"وَٱلۡفَجۡرِ","p":593,"j":30},{"a":2,"t":"وَلَيَالٍ عَشۡرࣲ‏","p":593,"j":30},{"a":3,"t":"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ","p":593,"j":30},{"a":4,"t":"وَٱلَّيۡلِ إِذَا يَسۡرِ","p":593,"j":30},{"a":5,"t":"هَلۡ فِي ذَٰلِكَ قَسَمࣱ لِّذِي حِجۡرٍ","p":593,"j":30},{"a":6,"t":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ","p":593,"j":30},{"a":7,"t":"إِرَمَ ذَاتِ ٱلۡعِمَادِ","p":593,"j":30},{"a":8,"t":"ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ","p":593,"j":30},{"a":9,"t":"وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ","p":593,"j":30},{"a":10,"t":"وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ","p":593,"j":30},{"a":11,"t":"ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ","p":593,"j":30},{"a":12,"t":"فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ","p":593,"j":30},{"a":13,"t":"فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ","p":593,"j":30},{"a":14,"t":"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ","p":593,"j":30},{"a":15,"t":"فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ","p":593,"j":30},{"a":16,"t":"وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ","p":593,"j":30},{"a":17,"t":"كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ","p":593,"j":30},{"a":18,"t":"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","p":593,"j":30},{"a":19,"t":"وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلࣰ ا لَّمࣰّ ا","p":593,"j":30},{"a":20,"t":"وَتُحِبُّونَ ٱلۡمَالَ حُبࣰّ ا جَمࣰّ ا","p":593,"j":30},{"a":21,"t":"كَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكࣰّ ا دَكࣰّ ا","p":593,"j":30},{"a":22,"t":"وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفࣰّ ا صَفࣰّ ا","p":593,"j":30},{"a":23,"t":"وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذࣲ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ","p":593,"j":30},{"a":24,"t":"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي","p":594,"j":30},{"a":25,"t":"فَيَوۡمَئِذࣲ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدࣱ‏","p":594,"j":30},{"a":26,"t":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدࣱ‏","p":594,"j":30},{"a":27,"t":"يَٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ","p":594,"j":30},{"a":28,"t":"ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةࣰ مَّرۡضِيَّةࣰ‏","p":594,"j":30},{"a":29,"t":"فَٱدۡخُلِي فِي عِبَٰدِي","p":594,"j":30},{"a":30,"t":"وَٱدۡخُلِي جَنَّتِي","p":594,"j":30}]}