{"n":105,"ayahs":[{"a":1,"t":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ","p":601,"j":30},{"a":2,"t":"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلࣲ‏","p":601,"j":30},{"a":3,"t":"وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ","p":601,"j":30},{"a":4,"t":"تَرۡمِيهِم بِحِجَارَةࣲ مِّن سِجِّيلࣲ‏","p":601,"j":30},{"a":5,"t":"فَجَعَلَهُمۡ كَعَصۡفࣲ مَّأۡكُولِۭ","p":601,"j":30}]}