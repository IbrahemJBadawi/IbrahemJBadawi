{"n":104,"ayahs":[{"a":1,"t":"وَيۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ","p":601,"j":30},{"a":2,"t":"ٱلَّذِي جَمَعَ مَالࣰ ا وَعَدَّدَهُۥ","p":601,"j":30},{"a":3,"t":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","p":601,"j":30},{"a":4,"t":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","p":601,"j":30},{"a":5,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","p":601,"j":30},{"a":6,"t":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","p":601,"j":30},{"a":7,"t":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","p":601,"j":30},{"a":8,"t":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةࣱ‏","p":601,"j":30},{"a":9,"t":"فِي عَمَدࣲ مُّمَدَّدَةِۭ","p":601,"j":30}]}