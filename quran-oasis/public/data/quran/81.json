{"n":81,"ayahs":[{"a":1,"t":"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ","p":586,"j":30},{"a":2,"t":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ","p":586,"j":30},{"a":3,"t":"وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ","p":586,"j":30},{"a":4,"t":"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ","p":586,"j":30},{"a":5,"t":"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ","p":586,"j":30},{"a":6,"t":"وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ","p":586,"j":30},{"a":7,"t":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ","p":586,"j":30},{"a":8,"t":"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ","p":586,"j":30},{"a":9,"t":"بِأَيِّ ذَنۢبࣲ قُتِلَتۡ","p":586,"j":30},{"a":10,"t":"وَإِذَا ٱلصُّحُفُ نُشِرَتۡ","p":586,"j":30},{"a":11,"t":"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ","p":586,"j":30},{"a":12,"t":"وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ","p":586,"j":30},{"a":13,"t":"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ","p":586,"j":30},{"a":14,"t":"عَلِمَتۡ نَفۡسࣱ مَّآ أَحۡضَرَتۡ","p":586,"j":30},{"a":15,"t":"فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ","p":586,"j":30},{"a":16,"t":"ٱلۡجَوَارِ ٱلۡكُنَّسِ","p":586,"j":30},{"a":17,"t":"وَٱلَّيۡلِ إِذَا عَسۡعَسَ","p":586,"j":30},{"a":18,"t":"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ","p":586,"j":30},{"a":19,"t":"إِنَّهُۥ لَقَوۡلُ رَسُولࣲ كَرِيمࣲ‏","p":586,"j":30},{"a":20,"t":"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينࣲ‏","p":586,"j":30},{"a":21,"t":"مُّطَاعࣲ ثَمَّ أَمِينࣲ‏","p":586,"j":30},{"a":22,"t":"وَمَا صَاحِبُكُم بِمَجۡنُونࣲ‏","p":586,"j":30},{"a":23,"t":"وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ","p":586,"j":30},{"a":24,"t":"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينࣲ‏","p":586,"j":30},{"a":25,"t":"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنࣲ رَّجِيمࣲ‏","p":586,"j":30},{"a":26,"t":"فَأَيۡنَ تَذۡهَبُونَ","p":586,"j":30},{"a":27,"t":"إِنۡ هُوَ إِلَّا ذِكۡرࣱ لِّلۡعَٰلَمِينَ","p":586,"j":30},{"a":28,"t":"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ","p":586,"j":30},{"a":29,"t":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ","p":586,"j":30}]}