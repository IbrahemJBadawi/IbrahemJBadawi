{"n":96,"ayahs":[{"a":1,"t":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","p":597,"j":30},{"a":2,"t":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","p":597,"j":30},{"a":3,"t":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","p":597,"j":30},{"a":4,"t":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","p":597,"j":30},{"a":5,"t":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","p":597,"j":30},{"a":6,"t":"كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ","p":597,"j":30},{"a":7,"t":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ","p":597,"j":30},{"a":8,"t":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ","p":597,"j":30},{"a":9,"t":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","p":597,"j":30},{"a":10,"t":"عَبۡدًا إِذَا صَلَّىٰٓ","p":597,"j":30},{"a":11,"t":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ","p":597,"j":30},{"a":12,"t":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ","p":597,"j":30},{"a":13,"t":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","p":597,"j":30},{"a":14,"t":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ","p":597,"j":30},{"a":15,"t":"كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ","p":597,"j":30},{"a":16,"t":"نَاصِيَةࣲ كَٰذِبَةٍ خَاطِئَةࣲ‏","p":597,"j":30},{"a":17,"t":"فَلۡيَدۡعُ نَادِيَهُۥ","p":597,"j":30},{"a":18,"t":"سَنَدۡعُ ٱلزَّبَانِيَةَ","p":597,"j":30},{"a":19,"t":"كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩","p":597,"j":30,"sj":1}]}