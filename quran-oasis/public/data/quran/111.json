{"n":111,"ayahs":[{"a":1,"t":"تَبَّتۡ يَدَآ أَبِي لَهَبࣲ وَتَبَّ","p":603,"j":30},{"a":2,"t":"مَآ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ","p":603,"j":30},{"a":3,"t":"سَيَصۡلَىٰ نَارࣰ ا ذَاتَ لَهَبࣲ‏","p":603,"j":30},{"a":4,"t":"وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ","p":603,"j":30},{"a":5,"t":"فِي جِيدِهَا حَبۡلࣱ مِّن مَّسَدِۭ","p":603,"j":30}]}