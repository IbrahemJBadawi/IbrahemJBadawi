{"n":88,"ayahs":[{"a":1,"t":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ","p":592,"j":30},{"a":2,"t":"وُجُوهࣱ يَوۡمَئِذٍ خَٰشِعَةٌ","p":592,"j":30},{"a":3,"t":"عَامِلَةࣱ نَّاصِبَةࣱ‏","p":592,"j":30},{"a":4,"t":"تَصۡلَىٰ نَارًا حَامِيَةࣰ‏","p":592,"j":30},{"a":5,"t":"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةࣲ‏","p":592,"j":30},{"a":6,"t":"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعࣲ‏","p":592,"j":30},{"a":7,"t":"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعࣲ‏","p":592,"j":30},{"a":8,"t":"وُجُوهࣱ يَوۡمَئِذࣲ نَّاعِمَةࣱ‏","p":592,"j":30},{"a":9,"t":"لِّسَعۡيِهَا رَاضِيَةࣱ‏","p":592,"j":30},{"a":10,"t":"فِي جَنَّةٍ عَالِيَةࣲ‏","p":592,"j":30},{"a":11,"t":"لَّا تَسۡمَعُ فِيهَا لَٰغِيَةࣰ‏","p":592,"j":30},{"a":12,"t":"فِيهَا عَيۡنࣱ جَارِيَةࣱ‏","p":592,"j":30},{"a":13,"t":"فِيهَا سُرُرࣱ مَّرۡفُوعَةࣱ‏","p":592,"j":30},{"a":14,"t":"وَأَكۡوَابࣱ مَّوۡضُوعَةࣱ‏","p":592,"j":30},{"a":15,"t":"وَنَمَارِقُ مَصۡفُوفَةࣱ‏","p":592,"j":30},{"a":16,"t":"وَزَرَابِيُّ مَبۡثُوثَةٌ","p":592,"j":30},{"a":17,"t":"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ","p":592,"j":30},{"a":18,"t":"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ","p":592,"j":30},{"a":19,"t":"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ","p":592,"j":30},{"a":20,"t":"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ","p":592,"j":30},{"a":21,"t":"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرࣱ‏","p":592,"j":30},{"a":22,"t":"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ","p":592,"j":30},{"a":23,"t":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","p":592,"j":30},{"a":24,"t":"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ","p":592,"j":30},{"a":25,"t":"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ","p":592,"j":30},{"a":26,"t":"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم","p":592,"j":30}]}