{"n":37,"ayahs":[{"a":1,"t":"وَٱلصَّٰٓفَّٰتِ صَفࣰّ ا","p":446,"j":23},{"a":2,"t":"فَٱلزَّٰجِرَٰتِ زَجۡرࣰ ا","p":446,"j":23},{"a":3,"t":"فَٱلتَّٰلِيَٰتِ ذِكۡرًا","p":446,"j":23},{"a":4,"t":"إِنَّ إِلَٰهَكُمۡ لَوَٰحِدࣱ‏","p":446,"j":23},{"a":5,"t":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ ٱلۡمَشَٰرِقِ","p":446,"j":23},{"a":6,"t":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِزِينَةٍ ٱلۡكَوَاكِبِ","p":446,"j":23},{"a":7,"t":"وَحِفۡظࣰ ا مِّن كُلِّ شَيۡطَٰنࣲ مَّارِدࣲ‏","p":446,"j":23},{"a":8,"t":"لَّا يَسَّمَّعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَيُقۡذَفُونَ مِن كُلِّ جَانِبࣲ‏","p":446,"j":23},{"a":9,"t":"دُحُورࣰ اۖ وَلَهُمۡ عَذَابࣱ وَاصِبٌ","p":446,"j":23},{"a":10,"t":"إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابࣱ ثَاقِبࣱ‏","p":446,"j":23},{"a":11,"t":"فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَآۚ إِنَّا خَلَقۡنَٰهُم مِّن طِينࣲ لَّازِبِۭ","p":446,"j":23},{"a":12,"t":"بَلۡ عَجِبۡتَ وَيَسۡخَرُونَ","p":446,"j":23},{"a":13,"t":"وَإِذَا ذُكِّرُواْ لَا يَذۡكُرُونَ","p":446,"j":23},{"a":14,"t":"وَإِذَا رَأَوۡاْ ءَايَةࣰ يَسۡتَسۡخِرُونَ","p":446,"j":23},{"a":15,"t":"وَقَالُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرࣱ مُّبِينٌ","p":446,"j":23},{"a":16,"t":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابࣰ ا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ","p":446,"j":23},{"a":17,"t":"أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ","p":446,"j":23},{"a":18,"t":"قُلۡ نَعَمۡ وَأَنتُمۡ دَٰخِرُونَ","p":446,"j":23},{"a":19,"t":"فَإِنَّمَا هِيَ زَجۡرَةࣱ وَٰحِدَةࣱ فَإِذَا هُمۡ يَنظُرُونَ","p":446,"j":23},{"a":20,"t":"وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ ٱلدِّينِ","p":446,"j":23},{"a":21,"t":"هَٰذَا يَوۡمُ ٱلۡفَصۡلِ ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ","p":446,"j":23},{"a":22,"t":"۞ٱحۡشُرُواْ ٱلَّذِينَ ظَلَمُواْ وَأَزۡوَٰجَهُمۡ وَمَا كَانُواْ يَعۡبُدُونَ","p":446,"j":23},{"a":23,"t":"مِن دُونِ ٱللَّهِ فَٱهۡدُوهُمۡ إِلَىٰ صِرَٰطِ ٱلۡجَحِيمِ","p":446,"j":23},{"a":24,"t":"وَقِفُوهُمۡۖ إِنَّهُم مَّسۡـُٔولُونَ","p":446,"j":23},{"a":25,"t":"مَا لَكُمۡ لَا تَنَاصَرُونَ","p":447,"j":23},{"a":26,"t":"بَلۡ هُمُ ٱلۡيَوۡمَ مُسۡتَسۡلِمُونَ","p":447,"j":23},{"a":27,"t":"وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضࣲ يَتَسَآءَلُونَ","p":447,"j":23},{"a":28,"t":"قَالُوٓاْ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ","p":447,"j":23},{"a":29,"t":"قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ","p":447,"j":23},{"a":30,"t":"وَمَا كَانَ لَنَا عَلَيۡكُم مِّن سُلۡطَٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمࣰ ا طَٰغِينَ","p":447,"j":23},{"a":31,"t":"فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآۖ إِنَّا لَذَآئِقُونَ","p":447,"j":23},{"a":32,"t":"فَأَغۡوَيۡنَٰكُمۡ إِنَّا كُنَّا غَٰوِينَ","p":447,"j":23},{"a":33,"t":"فَإِنَّهُمۡ يَوۡمَئِذࣲ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ","p":447,"j":23},{"a":34,"t":"إِنَّا كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ","p":447,"j":23},{"a":35,"t":"إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ","p":447,"j":23},{"a":36,"t":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرࣲ مَّجۡنُونِۭ","p":447,"j":23},{"a":37,"t":"بَلۡ جَآءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِينَ","p":447,"j":23},{"a":38,"t":"إِنَّكُمۡ لَذَآئِقُواْ ٱلۡعَذَابِ ٱلۡأَلِيمِ","p":447,"j":23},{"a":39,"t":"وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ","p":447,"j":23},{"a":40,"t":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ","p":447,"j":23},{"a":41,"t":"أُوْلَٰٓئِكَ لَهُمۡ رِزۡقࣱ مَّعۡلُومࣱ‏","p":447,"j":23},{"a":42,"t":"فَوَٰكِهُ وَهُم مُّكۡرَمُونَ","p":447,"j":23},{"a":43,"t":"فِي جَنَّٰتِ ٱلنَّعِيمِ","p":447,"j":23},{"a":44,"t":"عَلَىٰ سُرُرࣲ مُّتَقَٰبِلِينَ","p":447,"j":23},{"a":45,"t":"يُطَافُ عَلَيۡهِم بِكَأۡسࣲ مِّن مَّعِينِۭ","p":447,"j":23},{"a":46,"t":"بَيۡضَآءَ لَذَّةࣲ لِّلشَّٰرِبِينَ","p":447,"j":23},{"a":47,"t":"لَا فِيهَا غَوۡلࣱ وَلَا هُمۡ عَنۡهَا يُنزَفُونَ","p":447,"j":23},{"a":48,"t":"وَعِندَهُمۡ قَٰصِرَٰتُ ٱلطَّرۡفِ عِينࣱ‏","p":447,"j":23},{"a":49,"t":"كَأَنَّهُنَّ بَيۡضࣱ مَّكۡنُونࣱ‏","p":447,"j":23},{"a":50,"t":"فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضࣲ يَتَسَآءَلُونَ","p":447,"j":23},{"a":51,"t":"قَالَ قَآئِلࣱ مِّنۡهُمۡ إِنِّي كَانَ لِي قَرِينࣱ‏","p":447,"j":23},{"a":52,"t":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ","p":448,"j":23},{"a":53,"t":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابࣰ ا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ","p":448,"j":23},{"a":54,"t":"قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ","p":448,"j":23},{"a":55,"t":"فَٱطَّلَعَ فَرَءَاهُ فِي سَوَآءِ ٱلۡجَحِيمِ","p":448,"j":23},{"a":56,"t":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ","p":448,"j":23},{"a":57,"t":"وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ","p":448,"j":23},{"a":58,"t":"أَفَمَا نَحۡنُ بِمَيِّتِينَ","p":448,"j":23},{"a":59,"t":"إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ","p":448,"j":23},{"a":60,"t":"إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ","p":448,"j":23},{"a":61,"t":"لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ","p":448,"j":23},{"a":62,"t":"أَذَٰلِكَ خَيۡرࣱ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ","p":448,"j":23},{"a":63,"t":"إِنَّا جَعَلۡنَٰهَا فِتۡنَةࣰ لِّلظَّٰلِمِينَ","p":448,"j":23},{"a":64,"t":"إِنَّهَا شَجَرَةࣱ تَخۡرُجُ فِيٓ أَصۡلِ ٱلۡجَحِيمِ","p":448,"j":23},{"a":65,"t":"طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ","p":448,"j":23},{"a":66,"t":"فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ","p":448,"j":23},{"a":67,"t":"ثُمَّ إِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبࣰ ا مِّنۡ حَمِيمࣲ‏","p":448,"j":23},{"a":68,"t":"ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِيمِ","p":448,"j":23},{"a":69,"t":"إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ","p":448,"j":23},{"a":70,"t":"فَهُمۡ عَلَىٰٓ ءَاثَٰرِهِمۡ يُهۡرَعُونَ","p":448,"j":23},{"a":71,"t":"وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِينَ","p":448,"j":23},{"a":72,"t":"وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ","p":448,"j":23},{"a":73,"t":"فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ","p":448,"j":23},{"a":74,"t":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ","p":448,"j":23},{"a":75,"t":"وَلَقَدۡ نَادَىٰنَا نُوحࣱ فَلَنِعۡمَ ٱلۡمُجِيبُونَ","p":448,"j":23},{"a":76,"t":"وَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ","p":448,"j":23},{"a":77,"t":"وَجَعَلۡنَا ذُرِّيَّتَهُۥ هُمُ