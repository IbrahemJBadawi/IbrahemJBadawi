{"n":74,"ayahs":[{"a":1,"t":"يَٰٓأَيُّهَا ٱلۡمُدَّثِّرُ","p":575,"j":29},{"a":2,"t":"قُمۡ فَأَنذِرۡ","p":575,"j":29},{"a":3,"t":"وَرَبَّكَ فَكَبِّرۡ","p":575,"j":29},{"a":4,"t":"وَثِيَابَكَ فَطَهِّرۡ","p":575,"j":29},{"a":5,"t":"وَٱلرُّجۡزَ فَٱهۡجُرۡ","p":575,"j":29},{"a":6,"t":"وَلَا تَمۡنُن تَسۡتَكۡثِرُ","p":575,"j":29},{"a":7,"t":"وَلِرَبِّكَ فَٱصۡبِرۡ","p":575,"j":29},{"a":8,"t":"فَإِذَا نُقِرَ فِي ٱلنَّاقُورِ","p":575,"j":29},{"a":9,"t":"فَذَٰلِكَ يَوۡمَئِذࣲ يَوۡمٌ عَسِيرٌ","p":575,"j":29},{"a":10,"t":"عَلَى ٱلۡكَٰفِرِينَ غَيۡرُ يَسِيرࣲ‏","p":575,"j":29},{"a":11,"t":"ذَرۡنِي وَمَنۡ خَلَقۡتُ وَحِيدࣰ ا","p":575,"j":29},{"a":12,"t":"وَجَعَلۡتُ لَهُۥ مَالࣰ ا مَّمۡدُودࣰ ا","p":575,"j":29},{"a":13,"t":"وَبَنِينَ شُهُودࣰ ا","p":575,"j":29},{"a":14,"t":"وَمَهَّدتُّ لَهُۥ تَمۡهِيدࣰ ا","p":575,"j":29},{"a":15,"t":"ثُمَّ يَطۡمَعُ أَنۡ أَزِيدَ","p":575,"j":29},{"a":16,"t":"كَلَّآۖ إِنَّهُۥ كَانَ لِأٓيَٰتِنَا عَنِيدࣰ ا","p":575,"j":29},{"a":17,"t":"سَأُرۡهِقُهُۥ صَعُودًا","p":575,"j":29},{"a":18,"t":"إِنَّهُۥ فَكَّرَ وَقَدَّرَ","p":576,"j":29},{"a":19,"t":"فَقُتِلَ كَيۡفَ قَدَّرَ","p":576,"j":29},{"a":20,"t":"ثُمَّ قُتِلَ كَيۡفَ قَدَّرَ","p":576,"j":29},{"a":21,"t":"ثُمَّ نَظَرَ","p":576,"j":29},{"a":22,"t":"ثُمَّ عَبَسَ وَبَسَرَ","p":576,"j":29},{"a":23,"t":"ثُمَّ أَدۡبَرَ وَٱسۡتَكۡبَرَ","p":576,"j":29},{"a":24,"t":"فَقَالَ إِنۡ هَٰذَآ إِلَّا سِحۡرࣱ يُؤۡثَرُ","p":576,"j":29},{"a":25,"t":"إِنۡ هَٰذَآ إِلَّا قَوۡلُ ٱلۡبَشَرِ","p":576,"j":29},{"a":26,"t":"سَأُصۡلِيهِ سَقَرَ","p":576,"j":29},{"a":27,"t":"وَمَآ أَدۡرَىٰكَ مَا سَقَرُ","p":576,"j":29},{"a":28,"t":"لَا تُبۡقِي وَلَا تَذَرُ","p":576,"j":29},{"a":29,"t":"لَوَّاحَةࣱ لِّلۡبَشَرِ","p":576,"j":29},{"a":30,"t":"عَلَيۡهَا تِسۡعَةَ عَشَرَ","p":576,"j":29},{"a":31,"t":"وَمَا جَعَلۡنَآ أَصۡحَٰبَ ٱلنَّارِ إِلَّا مَلَٰٓئِكَةࣰۖ وَمَا جَعَلۡنَا عِدَّتَهُمۡ إِلَّا فِتۡنَةࣰ لِّلَّذِينَ كَفَرُواْ لِيَسۡتَيۡقِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَيَزۡدَادَ ٱلَّذِينَ ءَامَنُوٓاْ إِيمَٰنࣰ ا وَلَا يَرۡتَابَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَٱلۡمُؤۡمِنُونَ وَلِيَقُولَ ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضࣱ وَٱلۡكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلࣰ اۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهۡدِي مَن يَشَآءُۚ وَمَا يَعۡلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَۚ وَمَا هِيَ إِلَّا ذِكۡرَىٰ لِلۡبَشَرِ","p":576,"j":29},{"a":32,"t":"كَلَّا وَٱلۡقَمَرِ","p":576,"j":29},{"a":33,"t":"وَٱلَّيۡلِ إِذۡ أَدۡبَرَ","p":576,"j":29},{"a":34,"t":"وَٱلصُّبۡحِ إِذَآ أَسۡفَرَ","p":576,"j":29},{"a":35,"t":"إِنَّهَا لَإِحۡدَى ٱلۡكُبَرِ","p":576,"j":29},{"a":36,"t":"نَذِيرࣰ ا لِّلۡبَشَرِ","p":576,"j":29},{"a":37,"t":"لِمَن شَآءَ مِنكُمۡ أَن يَتَقَدَّمَ أَوۡ يَتَأَخَّرَ","p":576,"j":29},{"a":38,"t":"كُلُّ نَفۡسِۭ بِمَا كَسَبَتۡ رَهِينَةٌ","p":576,"j":29},{"a":39,"t":"إِلَّآ أَصۡحَٰبَ ٱلۡيَمِينِ","p":576,"j":29},{"a":40,"t":"فِي جَنَّٰتࣲ يَتَسَآءَلُونَ","p":576,"j":29},{"a":41,"t":"عَنِ ٱلۡمُجۡرِمِينَ","p":576,"j":29},{"a":42,"t":"مَا سَلَكَكُمۡ فِي سَقَرَ","p":576,"j":29},{"a":43,"t":"قَالُواْ لَمۡ نَكُ مِنَ ٱلۡمُصَلِّينَ","p":576,"j":29},{"a":44,"t":"وَلَمۡ نَكُ نُطۡعِمُ ٱلۡمِسۡكِينَ","p":576,"j":29},{"a":45,"t":"وَكُنَّا نَخُوضُ مَعَ ٱلۡخَآئِضِينَ","p":576,"j":29},{"a":46,"t":"وَكُنَّا نُكَذِّبُ بِيَوۡمِ ٱلدِّينِ","p":576,"j":29},{"a":47,"t":"حَتَّىٰٓ أَتَىٰنَا ٱلۡيَقِينُ","p":576,"j":29},{"a":48,"t":"فَمَا تَنفَعُهُمۡ شَفَٰعَةُ ٱلشَّٰفِعِينَ","p":577,"j":29},{"a":49,"t":"فَمَا لَهُمۡ عَنِ ٱلتَّذۡكِرَةِ مُعۡرِضِينَ","p":577,"j":29},{"a":50,"t":"كَأَنَّهُمۡ حُمُرࣱ مُّسۡتَنفِرَةࣱ‏","p":577,"j":29},{"a":51,"t":"فَرَّتۡ مِن قَسۡوَرَةِۭ","p":577,"j":29},{"a":52,"t":"بَلۡ يُرِيدُ كُلُّ ٱمۡرِيࣲٕ مِّنۡهُمۡ أَن يُؤۡتَىٰ صُحُفࣰ ا مُّنَشَّرَةࣰ‏","p":577,"j":29},{"a":53,"t":"كَلَّاۖ بَل لَّا يَخَافُونَ ٱلۡأٓخِرَةَ","p":577,"j":29},{"a":54,"t":"كَلَّآ إِنَّهُۥ تَذۡكِرَةࣱ‏","p":577,"j":29},{"a":55,"t":"فَمَن شَآءَ ذَكَرَهُۥ","p":577,"j":29},{"a":56,"t":"وَمَا يَذۡكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ هُوَ أَهۡلُ ٱلتَّقۡوَىٰ وَأَهۡلُ ٱلۡمَغۡفِرَةِ","p":577,"j":29}]}