لۡمَرۡءُ مِنۡ أَخِيهِ","p":585,"j":30},{"a":35,"t":"وَأُمِّهِۦ وَأَبِيهِ","p":585,"j":30},{"a":36,"t":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","p":585,"j":30},{"a":37,"t":"لِكُلِّ ٱمۡرِيࣲٕ مِّنۡهُمۡ يَوۡمَئِذࣲ شَأۡنࣱ يُغۡنِيهِ","p":585,"j":30},{"a":38,"t":"وُجُوهࣱ يَوۡمَئِذࣲ مُّسۡفِرَةࣱ‏","p":585,"j":30},{"a":39,"t":"ضَاحِكَةࣱ مُّسۡتَبۡشِرَةࣱ‏","p":585,"j":30},{"a":40,"t":"وَوُجُوهࣱ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةࣱ‏","p":585,"j":30},{"a":41,"t":"تَرۡهَقُهَا قَتَرَةٌ","p":585,"j":30},{"a":42,"t":"أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ","p":585,"j":30}]}