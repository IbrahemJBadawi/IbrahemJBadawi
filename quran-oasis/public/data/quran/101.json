{"n":101,"ayahs":[{"a":1,"t":"ٱلۡقَارِعَةُ","p":600,"j":30},{"a":2,"t":"مَا ٱلۡقَارِعَةُ","p":600,"j":30},{"a":3,"t":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","p":600,"j":30},{"a":4,"t":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","p":600,"j":30},{"a":5,"t":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","p":600,"j":30},{"a":6,"t":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","p":600,"j":30},{"a":7,"t":"فَهُوَ فِي عِيشَةࣲ رَّاضِيَةࣲ‏","p":600,"j":30},{"a":8,"t":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","p":600,"j":30},{"a":9,"t":"فَأُمُّهُۥ هَاوِيَةࣱ‏","p":600,"j":30},{"a":10,"t":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","p":600,"j":30},{"a":11,"t":"نَارٌ حَامِيَةُۢ","p":600,"j":30}]}