{"n":82,"ayahs":[{"a":1,"t":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ","p":587,"j":30},{"a":2,"t":"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ","p":587,"j":30},{"a":3,"t":"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ","p":587,"j":30},{"a":4,"t":"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ","p":587,"j":30},{"a":5,"t":"عَلِمَتۡ نَفۡسࣱ مَّا قَدَّمَتۡ وَأَخَّرَتۡ","p":587,"j":30},{"a":6,"t":"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ","p":587,"j":30},{"a":7,"t":"ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","p":587,"j":30},{"a":8,"t":"فِيٓ أَيِّ صُورَةࣲ مَّا شَآءَ رَكَّبَكَ","p":587,"j":30},{"a":9,"t":"كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ","p":587,"j":30},{"a":10,"t":"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ","p":587,"j":30},{"a":11,"t":"كِرَامࣰ ا كَٰتِبِينَ","p":587,"j":30},{"a":12,"t":"يَعۡلَمُونَ مَا تَفۡعَلُونَ","p":587,"j":30},{"a":13,"t":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمࣲ‏","p":587,"j":30},{"a":14,"t":"وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمࣲ‏","p":587,"j":30},{"a":15,"t":"يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ","p":587,"j":30},{"a":16,"t":"وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ","p":587,"j":30},{"a":17,"t":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ","p":587,"j":30},{"a":18,"t":"ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ","p":587,"j":30},{"a":19,"t":"يَوۡمَ لَا تَمۡلِكُ نَفۡسࣱ لِّنَفۡسࣲ شَيۡـࣰٔ اۖ وَٱلۡأَمۡرُ يَوۡمَئِذࣲ لِّلَّهِ","p":587,"j":30}]}