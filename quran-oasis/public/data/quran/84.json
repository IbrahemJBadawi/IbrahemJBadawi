{"n":84,"ayahs":[{"a":1,"t":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ","p":589,"j":30},{"a":2,"t":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","p":589,"j":30},{"a":3,"t":"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ","p":589,"j":30},{"a":4,"t":"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ","p":589,"j":30},{"a":5,"t":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","p":589,"j":30},{"a":6,"t":"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحࣰ ا فَمُلَٰقِيهِ","p":589,"j":30},{"a":7,"t":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ","p":589,"j":30},{"a":8,"t":"فَسَوۡفَ يُحَاسَبُ حِسَابࣰ ا يَسِيرࣰ ا","p":589,"j":30},{"a":9,"t":"وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورࣰ ا","p":589,"j":30},{"a":10,"t":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ","p":589,"j":30},{"a":11,"t":"فَسَوۡفَ يَدۡعُواْ ثُبُورࣰ ا","p":589,"j":30},{"a":12,"t":"وَيَصۡلَىٰ سَعِيرًا","p":589,"j":30},{"a":13,"t":"إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا","p":589,"j":30},{"a":14,"t":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","p":589,"j":30},{"a":15,"t":"بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرࣰ ا","p":589,"j":30},{"a":16,"t":"فَلَآ أُقۡسِمُ بِٱلشَّفَقِ","p":589,"j":30},{"a":17,"t":"وَٱلَّيۡلِ وَمَا وَسَقَ","p":589,"j":30},{"a":18,"t":"وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ","p":589,"j":30},{"a":19,"t":"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقࣲ‏","p":589,"j":30},{"a":20,"t":"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ","p":589,"j":30},{"a":21,"t":"وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩","p":589,"j":30,"sj":1},{"a":22,"t":"بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ","p":589,"j":30},{"a":23,"t":"وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ","p":589,"j":30},{"a":24,"t":"فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ","p":589,"j":30},{"a":25,"t":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ","p":589,"j":30}]}