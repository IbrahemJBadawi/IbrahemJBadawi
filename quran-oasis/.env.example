# ── Supabase (اختياري: بدونه تعمل المنصة بوضع الزائر مع حفظ محلي) ──
# من لوحة Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# المفتاح العام (publishable / anon). آمن للواجهة لأن الحماية تتم عبر RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# رابط الموقع الأساسي (يُستخدم في SEO وروابط البريد)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# بريد التواصل الظاهر في صفحة التواصل
NEXT_PUBLIC_CONTACT_EMAIL=

# ملاحظة: لا تضع مفتاح service_role هنا ولا في أي متغير يبدأ بـ NEXT_PUBLIC_.
# المنصة لا تحتاج service_role إطلاقًا؛ إنشاء المدير يتم بأمر SQL من لوحة Supabase.
