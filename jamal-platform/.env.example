# ---------------------------------------------------------------------------
# Jamal Platform — environment variables. Copy to .env.local (`npm run setup`
# does it for you and generates AUTH_SECRET). Never commit real values.
# ---------------------------------------------------------------------------

# Public base URL (used for SEO, sitemap and auth e-mail redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Empty  → embedded PGlite database in .data/pglite (zero setup, local dev only).
# Set    → any Postgres. For Supabase use the *Transaction pooler* string
#          (Project → Connect → Transaction pooler, port 6543). SERVER ONLY.
DATABASE_URL=

# --- Authentication ---------------------------------------------------------
# local    → built-in email/password (bcrypt + signed httpOnly cookie).
# supabase → Supabase Auth (needs the two NEXT_PUBLIC_SUPABASE_* values).
AUTH_PROVIDER=local
# 32+ random characters; signs local session cookies.
AUTH_SECRET=

# Supabase (only when AUTH_PROVIDER=supabase). The anon/publishable key is
# safe in the browser; RLS protects every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Product image uploads from the admin. Local mode stores files in
# .data/uploads. With Supabase, files go to a public Storage bucket using the
# service-role key — SERVER ONLY, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# --- E-mail notifications (optional) ------------------------------------------
# Notifications are always stored in the app. E-mails are queued and sent only
# when these are set (Resend has a free tier). The scheduler calls
# POST /api/email/dispatch with "Authorization: Bearer $CRON_SECRET".
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=

# --- AI shopping assistant (optional, paid per use) -------------------------
# Anthropic API key. Without it the assistant shows as unavailable.
# Optional shopping assistant (Google Gemini; free tier available). Empty = hidden.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT_USER=30
AI_DAILY_LIMIT_GUEST=10

# Optional: bank-transfer details filled in once on first start, only while the
# admin settings are still empty (the admin page is the place to change them).
# Never applied to demo deployments.
BANK_BENEFICIARY_NAME=
BANK_NAME=
BANK_TRANSFER_DETAILS=
BANK_INSTRUCTIONS=

# --- Launch -----------------------------------------------------------------
# The store owner's admin account. With Supabase Auth it becomes admin once the
# e-mail is confirmed; with local auth ADMIN_PASSWORD (10+ chars) creates it.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Web push needs no provider. Keys are generated once and kept in the database;
# set these only to pin your own pair (npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_CONTACT_EMAIL=
# Google sign-in without Supabase (with Supabase, enable Google in its dashboard instead).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
